<Window x:Class="KioskApp.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קיוסק הספרייה - בחירת תוכנה"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource KioskBodyFont}"
        Foreground="{StaticResource KioskTextBrush}"
        Background="{StaticResource KioskGroundBrush}">
    <DockPanel>
        <!-- פס חום עליון (פרטי המשתמש, יתרה וניתוק - בלשונית הצפה) -->
        <Border DockPanel.Dock="Top" Height="8" Background="{StaticResource KioskBrandBrush}" />

        <Border DockPanel.Dock="Bottom" Background="{StaticResource KioskBrandBrush}" Padding="0,11">
            <TextBlock x:Name="FooterText" FontSize="15" Foreground="{StaticResource KioskOnBrandBrush}"
                       HorizontalAlignment="Center" />
        </Border>

        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,44,0,20">
            <TextBlock x:Name="WelcomeText" Text="שלום!" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource KioskAccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="במה תרצו להשתמש?" Style="{StaticResource KioskHeading}" FontSize="32"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="AppsPanel" HorizontalAlignment="Center" Margin="30,10,30,30" />
        </ScrollViewer>
    </DockPanel>
</Window>
