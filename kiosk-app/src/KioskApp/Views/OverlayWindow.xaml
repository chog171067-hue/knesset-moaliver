<Window x:Class="KioskApp.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קיוסק הספרייה"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="RightToLeft"
        Left="0" Top="0"
        Height="60"
        FontFamily="{StaticResource KioskBodyFont}"
        Foreground="{StaticResource KioskTextBrush}"
        Background="{StaticResource KioskCardBrush}">
    <Border BorderBrush="{StaticResource KioskOutlineBrush}" BorderThickness="0,0,0,2" Padding="20,0">
        <DockPanel LastChildFill="False" VerticalAlignment="Center">
            <!-- ימין: מי מחובר, יתרה, זמן -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="UsernameText" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                <Border Style="{StaticResource KioskPill}" Margin="0,0,20,0">
                    <TextBlock x:Name="BalanceText" FontSize="15" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="TimerText" FontSize="15" Foreground="{StaticResource KioskMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- שמאל: פעולות -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TextEditorButton" Style="{StaticResource KioskSecondaryButton}" MinHeight="40" Padding="14,0"
                        FontSize="15" Margin="0,0,8,0" Click="OnTextEditorClick" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPen}" Style="{StaticResource KioskIcon}" Width="16" Height="16" Margin="0,0,6,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="עורך טקסט" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource KioskSecondaryButton}" MinHeight="40" Padding="14,0"
                        FontSize="15" Margin="0,0,8,0" Click="OnSwitchAppClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGrid}" Style="{StaticResource KioskIcon}" Width="16" Height="16" Margin="0,0,6,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="החלפת תוכנה" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource KioskPrimaryButton}" MinHeight="40" Padding="14,0"
                        FontSize="15" Margin="0,0,8,0" Click="OnTopupClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource KioskIcon}" Width="16" Height="16" Margin="0,0,6,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="הטענת כסף" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource KioskDangerButton}" MinHeight="40" Padding="14,0"
                        FontSize="15" Click="OnLogoutClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconLogout}" Style="{StaticResource KioskIcon}" Width="16" Height="16" Margin="0,0,6,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="ניתוק" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
