<Window x:Class="KioskApp.Views.TopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="הטענת כסף"
        Width="520" Height="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="White">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" x:Name="AmountPanel">
            <TextBlock Text="הטענת כסף לחשבון" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource KioskPrimaryBrush}" Margin="0,0,0,15" />
            <TextBlock Text="סכום להטענה (₪)" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBox x:Name="AmountBox" FontSize="16" Padding="8" Margin="0,0,0,15" />
            <Button x:Name="ContinueButton" Content="המשך לתשלום" FontSize="15" FontWeight="Bold"
                    Padding="10" Background="{StaticResource KioskAccentBrush}" Foreground="White"
                    BorderThickness="0" Click="OnContinueClick" Cursor="Hand" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource KioskDangerBrush}" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" x:Name="StatusText" FontWeight="Bold" Margin="0,10,0,10"
                   Foreground="{StaticResource KioskPrimaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
    </DockPanel>
</Window>
