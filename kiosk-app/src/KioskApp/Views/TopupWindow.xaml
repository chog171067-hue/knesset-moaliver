<Window x:Class="KioskApp.Views.TopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="הטענת כסף"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource KioskBodyFont}"
        Foreground="{StaticResource KioskTextBrush}"
        Background="{StaticResource KioskGroundBrush}">
    <!-- כרטיס שמנת במרכז המסך, כמו שאר חלונות הקיוסק. החלון עצמו לא שקוף כי הדפדפן הפנימי
         (טופס האשראי של נדרים פלוס) לא מוצג בחלון שקוף - לכן הרקע הוא צבע הרקע של הקיוסק -->
    <Border Background="{StaticResource KioskCardBrush}" BorderBrush="{StaticResource KioskTanBrush}"
            BorderThickness="2" CornerRadius="20" Width="560"
            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Padding="34,22,34,30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.14" Color="#5B4636" />
        </Border.Effect>
        <StackPanel>
            <!-- כותרת + X לסגירה -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="הטענת כסף לחשבון" Style="{StaticResource KioskHeading}" FontSize="30"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6,12,0" />
                <Button Grid.Column="1" x:Name="CloseButton" Width="42" Height="42" VerticalAlignment="Top"
                        Cursor="Hand" ToolTip="סגירה" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="21" Background="{StaticResource KioskSoftBrush}">
                                <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource KioskIcon}" Width="16" Height="16"
                                      StrokeThickness="2.2" Stroke="{StaticResource KioskSecondaryTextBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource KioskBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- שלב 1: סכום -->
            <StackPanel x:Name="AmountPanel">
                <TextBlock x:Name="AmountLabel" Text="סכום להטענה (₪)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="AmountBox" Style="{StaticResource KioskTextBox}" Margin="0,0,0,18" />
                <!-- פתיחת חשבון: הסכום קבוע (נקבע בדף הניהול), מוצג ולא נערך -->
                <Border x:Name="FixedAmountBox" Background="{StaticResource KioskSoftBrush}" CornerRadius="12"
                        Padding="18,14" Margin="0,0,0,18" Visibility="Collapsed">
                    <TextBlock x:Name="FixedAmountText" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <Button x:Name="ContinueButton" Content="תשלום בכרטיס אשראי" Style="{StaticResource KioskPrimaryButton}"
                        MinHeight="52" FontSize="18" Click="OnContinueClick" />
                <!-- הדף הרגיל של נדרים פלוס: כניסה לאזור האישי שלהם ותשלום בכרטיס שנשמר שם -->
                <Button x:Name="OnlinePayButton" Style="{StaticResource KioskSecondaryButton}"
                        MinHeight="52" FontSize="17" Margin="0,10,0,0" Click="OnOnlinePayClick">
                    <StackPanel Margin="0,6">
                        <TextBlock Text="תשלום בכרטיס שמור בנדרים פלוס" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="רק למי שיש כבר אזור אישי בנדרים פלוס עם כרטיס אשראי שמור"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KioskAccentBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource KioskDangerBrush}" FontWeight="SemiBold" FontSize="15"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- שלב 2: פרטי כרטיס האשראי (טופס של נדרים פלוס, במסגרת) -->
            <StackPanel x:Name="PaymentPanel" Visibility="Collapsed">
                <Border Background="{StaticResource KioskSoftBrush}" CornerRadius="12" Padding="16,10" Margin="0,0,0,14">
                    <TextBlock x:Name="PaymentSummaryText" FontSize="17" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="פרטי כרטיס אשראי" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="הקלידו את פרטי הכרטיס ולחצו &quot;בצע תשלום&quot;" FontSize="14"
                           Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,10" />
                <Border BorderBrush="{StaticResource KioskOutlineBrush}" BorderThickness="1" CornerRadius="14"
                        Background="White" Padding="10,8">
                    <wv2:WebView2 x:Name="WebView" Height="380" />
                </Border>
                <Button x:Name="PayButton" Content="בצע תשלום" Style="{StaticResource KioskPrimaryButton}"
                        MinHeight="54" FontSize="20" Margin="0,16,0,0" Click="OnPayClick" />
                <TextBlock Text="התשלום מאובטח ומתבצע דרך נדרים פלוס" FontSize="13"
                           Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
