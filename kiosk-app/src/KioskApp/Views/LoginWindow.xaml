<Window x:Class="KioskApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קיוסק הספרייה - התחברות"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource KioskBodyFont}"
        Foreground="{StaticResource KioskTextBrush}"
        Background="{StaticResource KioskGroundBrush}">
    <Window.Resources>
        <!-- כפתור-קישור שקוף (חזרה, שכחתי סיסמה, ביטול) -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource KioskAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource KioskMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- פינה ימנית עליונה: שם הספרייה -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,28,40,0">
            <Path Data="{StaticResource IconBook}" Style="{StaticResource KioskIcon}" Width="34" Height="34"
                  Stroke="{StaticResource KioskAccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ספריית בית הכנסת מוהליבר" Style="{StaticResource KioskHeading}" FontSize="22" />
                <TextBlock Text="עמדת קיוסק" FontSize="14" Foreground="{StaticResource KioskMutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- פינה שמאלית עליונה: שעה ותאריך עברי -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="40,30,40,0">
            <TextBlock x:Name="ClockText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock x:Name="DateText" FontSize="14" Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- ===== מסך הפתיחה: שני ריבועים ===== -->
        <StackPanel x:Name="ChoicePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="ברוכים הבאים" Style="{StaticResource KioskHeading}" FontSize="40"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="לשימוש בעמדה יש להיכנס לחשבון" FontSize="18"
                       Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,30" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ChooseSignupButton" Style="{StaticResource KioskTileButton}" Width="300" Height="260"
                        Margin="16" Click="OnChooseSignupClick">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="20" Background="{StaticResource KioskSoftBrush}"
                                Margin="0,0,0,18">
                            <Path Data="{StaticResource IconUserPlus}" Style="{StaticResource KioskIcon}" Width="44" Height="44"
                                  StrokeThickness="1.6" Stroke="{StaticResource KioskAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="פתיחת חשבון" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="בפעם הראשונה בעמדה" FontSize="15" Foreground="{StaticResource KioskMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="ChooseLoginButton" Style="{StaticResource KioskTileButton}" Width="300" Height="260"
                        Margin="16" Click="OnChooseLoginClick">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="20" Background="{StaticResource KioskSoftBrush}"
                                Margin="0,0,0,18">
                            <Path Data="{StaticResource IconLogin}" Style="{StaticResource KioskIcon}" Width="44" Height="44"
                                  StrokeThickness="1.6" Stroke="{StaticResource KioskAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="כניסה לחשבון" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="עם תעודת זהות וסיסמה" FontSize="15" Foreground="{StaticResource KioskMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ===== הכרטיס המרכזי: כניסה / פתיחת חשבון / שכחתי סיסמה / סיסמה חדשה ===== -->
        <Border x:Name="CardBorder" Visibility="Collapsed"
                Background="{StaticResource KioskCardBrush}" BorderBrush="{StaticResource KioskBorderBrush}"
                BorderThickness="1" CornerRadius="20" Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,30,40,26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.12" Color="#5B4636" />
            </Border.Effect>
            <StackPanel>
                <Grid>

                    <!-- כניסה לחשבון -->
                    <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                        <TextBlock Text="כניסה לחשבון" Style="{StaticResource KioskHeading}" FontSize="32"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="התחברו עם תעודת הזהות והסיסמה שלכם" FontSize="16"
                                   Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />

                        <TextBlock Text="תעודת זהות" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UsernameBox" Style="{StaticResource KioskTextBox}" Margin="0,0,0,18"
                                 KeyDown="OnFieldKeyDown" />

                        <TextBlock Text="סיסמה" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource KioskPasswordBox}" Margin="0,0,0,24"
                                     KeyDown="OnFieldKeyDown" />

                        <Button x:Name="LoginButton" Content="התחברות" Style="{StaticResource KioskPrimaryButton}"
                                MinHeight="52" FontSize="19" Click="OnLoginClick" />

                        <!-- מוצג רק כשמוגדר מספר לשחזור סיסמה (דף הניהול ← קיוסק ספרייה ← הגדרות) -->
                        <Button x:Name="ForgotPasswordButton" Content="שכחתי סיסמה" Style="{StaticResource LinkButton}"
                                Margin="0,12,0,0" Click="OnForgotPasswordClick" Visibility="Collapsed" />

                        <Button Content="חזרה" Style="{StaticResource LinkButton}" Margin="0,4,0,0"
                                Foreground="{StaticResource KioskMutedBrush}" Click="OnBackToChoiceClick" />
                    </StackPanel>

                    <!-- פתיחת חשבון -->
                    <StackPanel x:Name="SignupPanel" Visibility="Collapsed">
                        <TextBlock Text="פתיחת חשבון" Style="{StaticResource KioskHeading}" FontSize="32"
                                   HorizontalAlignment="Center" Margin="0,0,0,18" />

                        <TextBlock Text="שם מלא" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SignupNameBox" Style="{StaticResource KioskTextBox}" Margin="0,0,0,14"
                                 MaxLength="60" KeyDown="OnSignupFieldKeyDown" />

                        <TextBlock Text="תעודת זהות" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SignupTzBox" Style="{StaticResource KioskTextBox}" Margin="0,0,0,14"
                                 MaxLength="9" PreviewTextInput="OnDigitsOnlyInput" KeyDown="OnSignupFieldKeyDown" />

                        <TextBlock Text="טלפון" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SignupPhoneBox" Style="{StaticResource KioskTextBox}"
                                 MaxLength="11" PreviewTextInput="OnPhoneInput" KeyDown="OnSignupFieldKeyDown" />
                        <TextBlock Text="המספר הזה ישמש בעתיד לשחזור הסיסמה במקרה שאבדה או נשכחה."
                                   Style="{StaticResource FieldHint}" Margin="0,4,0,16" />

                        <!-- בחירת סיסמה - מודגשת משאר השדות -->
                        <Border Background="{StaticResource KioskSoftBrush}" BorderBrush="{StaticResource KioskAccentBrush}"
                                BorderThickness="1.5" CornerRadius="14" Padding="16,14,16,14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="בחירת סיסמה (4 עד 8 ספרות)" FontSize="17" FontWeight="Bold" Margin="0,0,0,8" />
                                <Grid>
                                    <PasswordBox x:Name="SignupPasswordBox" Style="{StaticResource KioskPasswordBox}"
                                                 MaxLength="8" PreviewTextInput="OnDigitsOnlyInput" KeyDown="OnSignupFieldKeyDown" />
                                    <TextBox x:Name="SignupPasswordVisibleBox" Style="{StaticResource KioskTextBox}"
                                             MaxLength="8" PreviewTextInput="OnDigitsOnlyInput" KeyDown="OnSignupFieldKeyDown"
                                             Visibility="Collapsed" />
                                </Grid>
                                <CheckBox x:Name="ShowSignupPasswordCheck" Content="הצג סיסמה" FontSize="14" Margin="0,8,0,0"
                                          Checked="OnShowSignupPasswordChanged" Unchecked="OnShowSignupPasswordChanged" />
                                <TextBlock Text="בהמשך, הכניסה לחשבון תתבצע באמצעות ת&quot;ז והסיסמה שבחרת בעת פתיחת החשבון."
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KioskSecondaryTextBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="SignupContinueButton" Content="המשך" Style="{StaticResource KioskPrimaryButton}"
                                MinHeight="52" FontSize="19" Click="OnSignupContinueClick" />

                        <Button Content="חזרה" Style="{StaticResource LinkButton}" Margin="0,8,0,0"
                                Foreground="{StaticResource KioskMutedBrush}" Click="OnBackToChoiceClick" />
                    </StackPanel>

                    <!-- שכחתי סיסמה: לאן להתקשר ומאיזה טלפון (מוסתר) -->
                    <StackPanel x:Name="ForgotPanel" Visibility="Collapsed">
                        <TextBlock Text="שחזור סיסמה בטלפון" Style="{StaticResource KioskHeading}" FontSize="30"
                                   HorizontalAlignment="Center" Margin="0,0,0,22" />

                        <TextBlock Text="לאיפוס הסיסמה יש להתקשר למספר" FontSize="16"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ResetPhoneText" FontSize="30" FontWeight="Bold"
                                   FlowDirection="LeftToRight" HorizontalAlignment="Center"
                                   Foreground="{StaticResource KioskAccentBrush}" Margin="0,4,0,18" />

                        <StackPanel x:Name="RegisteredPhoneSection">
                            <TextBlock Text="מהטלפון שנרשמת איתו למערכת:" FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MaskedPhoneText" FontSize="24" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Center"
                                       Margin="0,4,0,18" />
                        </StackPanel>

                        <TextBlock x:Name="ForgotInstructionsText" FontSize="15"
                                   Foreground="{StaticResource KioskMutedBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />

                        <Button Content="חזרה למסך הכניסה" Style="{StaticResource KioskPrimaryButton}"
                                MinHeight="52" FontSize="19" Click="OnBackToLoginClick" />
                    </StackPanel>

                    <!-- בחירת סיסמה חדשה - אחרי כניסה עם סיסמה זמנית מהטלפון -->
                    <StackPanel x:Name="ChangePasswordPanel" Visibility="Collapsed">
                        <TextBlock Text="בחירת סיסמה חדשה" Style="{StaticResource KioskHeading}" FontSize="30"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="נכנסתם עם סיסמה זמנית. כדי להמשיך יש לבחור סיסמה חדשה (לפחות 4 תווים)."
                                   FontSize="15" Foreground="{StaticResource KioskMutedBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />

                        <TextBlock Text="סיסמה חדשה" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource KioskPasswordBox}" Margin="0,0,0,18"
                                     KeyDown="OnChangeFieldKeyDown" />

                        <TextBlock Text="אימות סיסמה חדשה" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource KioskPasswordBox}" Margin="0,0,0,24"
                                     KeyDown="OnChangeFieldKeyDown" />

                        <Button x:Name="ChangePasswordButton" Content="שמירה וכניסה" Style="{StaticResource KioskPrimaryButton}"
                                MinHeight="52" FontSize="19" Click="OnChangePasswordClick" />

                        <Button Content="ביטול" Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                                Foreground="{StaticResource KioskMutedBrush}" Click="OnCancelChangeClick" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource KioskDangerBrush}"
                           FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,14,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock Text="לעזרה פנו לצוות הספרייה" FontSize="14" Foreground="{StaticResource KioskMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />

        <!-- ===== חלון קופץ אחרי "המשך": חבר קהילה + הטענה לפתיחת החשבון ===== -->
        <Grid x:Name="SignupOfferOverlay" Visibility="Collapsed" Background="#993E2F23">
            <Border Background="{StaticResource KioskCardBrush}" CornerRadius="20" Width="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.25" Color="#3E2F23" />
                </Border.Effect>
                <StackPanel>
                    <!-- חצי עליון: חבר קהילה (רק למי שברשימת חברי הקהילה) -->
                    <Border x:Name="MemberSection" Background="{StaticResource KioskSoftBrush}"
                            CornerRadius="20,20,0,0" Padding="36,28,36,24">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="{StaticResource KioskSuccessBrush}" CornerRadius="18" Padding="16,7"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}" Style="{StaticResource KioskIcon}" Width="18" Height="18"
                                          Stroke="White" StrokeThickness="2.4" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="חבר קהילה" Foreground="White" FontSize="17" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="הינך זכאי להנחות בתעריפי השימוש" FontSize="19" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- חצי תחתון: ההטענה -->
                    <StackPanel Margin="36,26,36,26">
                        <TextBlock x:Name="SignupAmountText" FontSize="19" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="התשלום נטען ליתרה שלך בחשבון האישי וישמש במלואו לשימוש ולהדפסות."
                                   FontSize="16" Foreground="{StaticResource KioskSecondaryTextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22" />
                        <Button x:Name="SignupPayButton" Content="להטענה" Style="{StaticResource KioskPrimaryButton}"
                                MinHeight="54" FontSize="20" Click="OnSignupPayClick" />
                        <Button Content="חזרה לעריכת הפרטים" Style="{StaticResource LinkButton}" Margin="0,10,0,0"
                                Foreground="{StaticResource KioskMutedBrush}" Click="OnSignupOfferBackClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
