<Window x:Class="KioskApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קיוסק הספרייה - התחברות"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        FlowDirection="RightToLeft"
        Background="{StaticResource KioskPrimaryBrush}">
    <Grid>
        <Border Background="White" CornerRadius="16" Width="420" MinHeight="380"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Margin="40" VerticalAlignment="Center">
                <Grid>

                    <!-- מסך כניסה רגיל -->
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="קיוסק הספרייה" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource KioskPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="התחברו עם שם המשתמש שקיבלתם מהצוות" FontSize="13"
                                   Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30" />

                        <TextBlock Text="שם משתמש" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="UsernameBox" FontSize="16" Padding="8" Margin="0,0,0,16"
                                 KeyDown="OnFieldKeyDown" />

                        <TextBlock Text="סיסמה" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="8" Margin="0,0,0,20"
                                     KeyDown="OnFieldKeyDown" />

                        <Button x:Name="LoginButton" Content="התחברות" FontSize="16" FontWeight="Bold"
                                Padding="10" Background="{StaticResource KioskAccentBrush}" Foreground="White"
                                BorderThickness="0" Click="OnLoginClick" Cursor="Hand" />

                        <!-- מוצג רק כשמוגדר מספר לשחזור סיסמה (דף הניהול ← קיוסק ספרייה ← הגדרות) -->
                        <Button x:Name="ForgotPasswordButton" Content="שכחתי סיסמה" FontSize="14"
                                Padding="6" Margin="0,14,0,0" HorizontalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource KioskPrimaryBrush}" Cursor="Hand"
                                Click="OnForgotPasswordClick" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- שכחתי סיסמה: לאן להתקשר ומאיזה טלפון (מוסתר) -->
                    <StackPanel x:Name="ForgotPanel" Visibility="Collapsed">
                        <TextBlock Text="שחזור סיסמה בטלפון" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource KioskPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" />

                        <TextBlock Text="לאיפוס הסיסמה יש להתקשר למספר" FontSize="15"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ResetPhoneText" FontSize="28" FontWeight="Bold"
                                   FlowDirection="LeftToRight" HorizontalAlignment="Center"
                                   Foreground="{StaticResource KioskPrimaryBrush}" Margin="0,4,0,16" />

                        <StackPanel x:Name="RegisteredPhoneSection">
                            <TextBlock Text="מהטלפון שנרשמת איתו למערכת:" FontSize="15"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MaskedPhoneText" FontSize="24" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Center"
                                       Margin="0,4,0,16" />
                        </StackPanel>

                        <TextBlock x:Name="ForgotInstructionsText" FontSize="13" Foreground="Gray"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                        <Button Content="חזרה למסך הכניסה" FontSize="16" FontWeight="Bold"
                                Padding="10" Background="{StaticResource KioskAccentBrush}" Foreground="White"
                                BorderThickness="0" Click="OnBackToLoginClick" Cursor="Hand" />
                    </StackPanel>

                    <!-- בחירת סיסמה חדשה - אחרי כניסה עם סיסמה זמנית מהטלפון -->
                    <StackPanel x:Name="ChangePasswordPanel" Visibility="Collapsed">
                        <TextBlock Text="בחירת סיסמה חדשה" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource KioskPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="נכנסתם עם סיסמה זמנית. כדי להמשיך יש לבחור סיסמה חדשה (לפחות 4 תווים)."
                                   FontSize="13" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,24" />

                        <TextBlock Text="סיסמה חדשה" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="NewPasswordBox" FontSize="16" Padding="8" Margin="0,0,0,16"
                                     KeyDown="OnChangeFieldKeyDown" />

                        <TextBlock Text="אימות סיסמה חדשה" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ConfirmPasswordBox" FontSize="16" Padding="8" Margin="0,0,0,20"
                                     KeyDown="OnChangeFieldKeyDown" />

                        <Button x:Name="ChangePasswordButton" Content="שמירה וכניסה" FontSize="16" FontWeight="Bold"
                                Padding="10" Background="{StaticResource KioskAccentBrush}" Foreground="White"
                                BorderThickness="0" Click="OnChangePasswordClick" Cursor="Hand" />

                        <Button Content="ביטול" FontSize="13" Padding="6" Margin="0,10,0,0"
                                Background="Transparent" BorderThickness="0" Foreground="Gray"
                                Click="OnCancelChangeClick" Cursor="Hand" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource KioskDangerBrush}"
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,16,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
