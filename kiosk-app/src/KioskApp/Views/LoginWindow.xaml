<Window x:Class="KioskApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קיוסק הספרייה - התחברות"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        FlowDirection="RightToLeft"
        Background="{StaticResource KioskPrimaryBrush}">
    <Grid>
        <Border Background="White" CornerRadius="16" Width="420" Height="380"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Margin="40" VerticalAlignment="Center">
                <TextBlock Text="קיוסק הספרייה" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource KioskPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="התחברו עם שם המשתמש שקיבלתם מהצוות" FontSize="13"
                           Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30" />

                <TextBlock Text="שם משתמש" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" FontSize="16" Padding="8" Margin="0,0,0,16"
                         KeyDown="OnFieldKeyDown" />

                <TextBlock Text="סיסמה" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="8" Margin="0,0,0,20"
                             KeyDown="OnFieldKeyDown" />

                <Button x:Name="LoginButton" Content="התחברות" FontSize="16" FontWeight="Bold"
                        Padding="10" Background="{StaticResource KioskAccentBrush}" Foreground="White"
                        BorderThickness="0" Click="OnLoginClick" Cursor="Hand" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource KioskDangerBrush}"
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,16,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
